{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SokoFileTransferPayload",
  "description": "Schema for high-speed Hotspot/LAN file handoffs",
  "type": "object",
  "required": [
    "transfer_id",
    "filename",
    "size_bytes",
    "download_url",
    "sha256"
  ],
  "properties": {
    "transfer_id": {
      "type": "string",
      "description": "Unique session transfer ID"
    },
    "filename": {
      "type": "string",
      "description": "Base filename (e.g. 'soko-release.apk')"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1,
      "description": "Exact file length in bytes"
    },
    "mime_type": {
      "type": "string",
      "default": "application/vnd.android.package-archive",
      "description": "MIME type of the offered asset"
    },
    "download_url": {
      "type": "string",
      "format": "uri",
      "description": "Direct HTTP URL on mobile hotspot (e.g., http://192.168.43.1:9090/download?token=XYZ)"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$",
      "description": "Cryptographic SHA-256 hash for integrity verification"
    }
  }
}
