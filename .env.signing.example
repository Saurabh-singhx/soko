# ==============================================================================
# Soko Android APK Release Signing Secrets
# Sourced automatically by scripts/build_apks.sh during local builds.
# Set these identical values as GitHub Repository Secrets for Actions CI parity.
# ==============================================================================

# 1. Base64 encoded representation of scripts/keystore/soko.keystore
ANDROID_KEYSTORE_

# 2. Keystore Passwords & Alias
ANDROID_KEYSTORE_PASSWORD=sokopassword
ANDROID_KEY_ALIAS=soko-key
ANDROID_KEY_PASSWORD=sokopassword
