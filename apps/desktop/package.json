{
  "name": "soko-desktop",
  "productName": "Soko",
  "description": "Soko Dynamic Island HUD & Android Device Companion",
  "author": "Soko Team <team@soko.local>",
  "homepage": "https://github.com/soko-ecosystem/soko",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
