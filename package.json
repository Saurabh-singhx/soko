{
  "name": "soko-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform desktop dynamic island & mobile companion with high-speed hotspot transfer and CLI control",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm --prefix apps/desktop run dev",
    "build:desktop": "npm --prefix apps/desktop run build",
    "build:linux": "npm --prefix apps/desktop run dist:linux",
    "build:windows": "npm --prefix apps/desktop run dist:win",
    "build:desktop:all": "npm --prefix apps/desktop run dist",
    "build:apk": "bash scripts/build_apks.sh",
    "build:all": "bash scripts/build_apks.sh && npm --prefix apps/desktop run dist",
    "bridge": "node scripts/soko_bridge.js",
    "start": "node scripts/soko_bridge.js",
    "test": "node scripts/test_integration.js",
    "test:island": "node scripts/test_idle_and_agent_completion.js",
    "version:bump": "node scripts/update_version.js"
  },
  "keywords": [
    "dynamic-island",
    "bluetooth",
    "tauri",
    "flutter",
    "antigravity-cli",
    "glassmorphism"
  ],
  "author": "Soko Project",
  "license": "MIT"
}
