{
  "name": "soko-monorepo",
  "version": "1.0.3",
  "private": true,
  "description": "Cross-platform desktop dynamic island & mobile companion with high-speed hotspot transfer and CLI control",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm --prefix apps/desktop run dev",
    "build:desktop": "npm --prefix apps/desktop run build",
    "build:linux": "npm --prefix apps/desktop run dist:linux",
    "build:windows": "npm --prefix apps/desktop run dist:win",
    "build:macos": "npm --prefix apps/desktop run dist:mac",
    "build:desktop:all": "npm --prefix apps/desktop run dist",
    "build:apk": "bash scripts/build_apks.sh",
    "build:all": "bash scripts/build_apks.sh && npm --prefix apps/desktop run dist",
    "bridge": "node scripts/soko_bridge.js",
    "start": "node scripts/soko_bridge.js",
    "test": "node tests/test_character_system.js && node tests/test_integration.js",
    "test:characters": "node tests/test_character_system.js",
    "test:security": "node tests/test_security.js",
    "test:discovery": "node tests/test_discovery.js",
    "test:scanning": "node tests/test_device_scanning_edge_cases.js",
    "test:island": "node tests/test_idle_and_agent_completion.js",
    "test:workspace": "node tests/test_workspace_resolution.js",
    "test:display": "node tests/test_display_and_updater.js",
    "test:audio": "node tests/test_audio_and_resilience.js",
    "test:all": "node tests/test_character_system.js && node tests/test_security.js && node tests/test_discovery.js && node tests/test_device_scanning_edge_cases.js && node tests/test_workspace_resolution.js && node tests/test_display_and_updater.js && node tests/test_audio_and_resilience.js && node tests/test_idle_and_agent_completion.js && node tests/test_integration.js",
    "version:bump": "node scripts/update_version.js"
  },
  "keywords": [
    "dynamic-island",
    "bluetooth",
    "tauri",
    "flutter",
    "antigravity-cli",
    "glassmorphism"
  ],
  "author": "Soko Project",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0"
  }
}
